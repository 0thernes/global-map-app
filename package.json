{
  "name": "global-map-app",
  "version": "1.1.0",
  "description": "OSINT 3D globe: sourced UAP, anomaly and reference layers on a CesiumJS Earth with keyless streamed imagery and terrain, an 8000 BCE to today timeline, hypothesis analysis and linked charts. Static site: GitHub Pages or file://.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "0thernes L.L.C. <0_0@0thernes.art> (https://0thernes.art)",
  "homepage": "https://0thernes.github.io/global-map-app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0thernes/global-map-app.git"
  },
  "bugs": {
    "url": "https://github.com/0thernes/global-map-app/issues"
  },
  "keywords": [
    "osint",
    "3d-globe",
    "webgl",
    "uap",
    "geospatial",
    "data-visualization",
    "timeline",
    "cesiumjs",
    "keyless"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "npm run lint:js && npm run format:check",
    "lint:js": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"test/unit/*.test.mjs\"",
    "test:data": "python3 scripts/validate_data.py",
    "test:smoke": "node test/smoke.mjs",
    "check": "npm run lint && npm test && npm run test:data && npm run build && npm run test:smoke",
    "package": "node scripts/package.mjs",
    "serve": "python3 -m http.server 8080"
  },
  "devDependencies": {
    "@cesium/core": "0.1.1",
    "@cesium/engine": "26.5.0",
    "@eslint/js": "^9.39.0",
    "d3-force": "^3.0.0",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "marked": "^18.1.3",
    "playwright": "^1.56.0",
    "prettier": "^3.6.0",
    "three": "^0.170.0"
  }
}
